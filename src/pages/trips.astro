---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import TripsMap from "../components/TripsMap.astro";
import TripCard from "../components/TripCard.astro";
import { trips } from "../data/trips.js";

const pageTitle = "Trips";

const centralAmericaTrips = trips.filter(
  (trip) => trip.region === "Central America",
);
const middleEastTrips = trips.filter((trip) => trip.region === "Middle East");
const europeTrips = trips.filter((trip) => trip.region === "Europe");
const southAmericaTrips = trips.filter(
  (trip) => trip.region === "South America",
);
const asiaTrips = trips.filter((trip) => trip.region === "Asia");
---

<Base>
  <Nav />
  <section>
    <h1 class="section-title">{pageTitle}</h1>

    <TripsMap />

    <p class="intro">
      Below you'll find a list of every trip I've taken. On desktop, click a
      country on the map to jump straight to it, or keep scrolling to browse
      the full list.
    </p>

    <div class="filters">
      <button data-filter="all">All</button>
      <button data-filter="Asia">Asia </button>
      <button data-filter="Central America">Central America</button>
      <button data-filter="Europe">Europe</button>
      <button data-filter="Middle East">Middle East</button>
      <button data-filter="South America">South America</button>
    </div>

    <div class="trip-grids">
      <div class="region" data-region="Asia">
        <h2>Asia</h2>
        <div class="trip-grid">
          {asiaTrips.map((trip) => <TripCard {...trip} />)}
        </div>
      </div>

      <div class="region" data-region="Central America">
        <h2>Central America</h2>
        <div class="trip-grid">
          {centralAmericaTrips.map((trip) => <TripCard {...trip} />)}
        </div>
      </div>

      <div class="region" data-region="Europe">
        <h2>Europe</h2>
        <div class="trip-grid">
          {europeTrips.map((trip) => <TripCard {...trip} />)}
        </div>
      </div>

      <div class="region" data-region="Middle East">
        <h2>Middle East</h2>
        <div class="trip-grid">
          {middleEastTrips.map((trip) => <TripCard {...trip} />)}
        </div>
      </div>

      <div class="region" data-region="South America">
        <h2>South America</h2>
        <div class="trip-grid">
          {southAmericaTrips.map((trip) => <TripCard {...trip} />)}
        </div>
      </div>
    </div>
  </section>

  <footer>
    <span class="footer-wordmark">Well Trodden</span>
    <span class="footer-strapline">Self-directed trips, honestly told.</span>
  </footer>
</Base>

<script>
  const buttons = document.querySelectorAll("[data-filter]");
  const regions = document.querySelectorAll("[data-region]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("active"));
      button.classList.add("active");
      const filter = button.dataset.filter;
      regions.forEach((region) => {
        region.style.display =
          filter === "all" || region.dataset.region === filter
            ? "block"
            : "none";
      });
    });
  });
</script>

<style>
  section {
    padding: 2rem 2.5rem 6rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--ink);
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .intro {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--stone);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 2.5rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .filters button {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.35rem 1rem;
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .filters button:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .filters button.active {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .trip-grids {
    margin-top: 4rem;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-wordmark {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
  }

  .footer-strapline {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--stone);
    letter-spacing: 0.03em;
  }

  .region {
    margin-bottom: 4rem;
    border-top: 1px solid var(--border);
    padding-top: 2.5rem;
  }

  .region h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: 0.02em;
    margin-bottom: 2rem;
  }
  .trip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .trip-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    section {
      padding: 2rem 1.25rem 4rem;
    }

    .trip-grid {
      grid-template-columns: 1fr;
    }

    footer {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      padding: 1.5rem 1.25rem;
    }
  }
</style>
