---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import TripCard from "../components/TripCard.astro";

import { trips } from "../data/trips.js";

const recentTrips = [...trips].sort((a, b) => b.date.localeCompare(a.date));
---

<Base title="Well Trodden">
  <Nav transparent />

  <section class="hero">
    <div class="hero-content">
      <h1>Well Trodden</h1>
      <p>
        No fluff. No package tours. Just the full story of trips we actually
        did.
      </p>
    </div>
  </section>

  <section class="about">
    <span class="section-label">About</span>
    <p>
      Well Trodden started out of frustration. Ten years of planning my trips
      instead of booking package holidays, and every time I sat down to research
      a destination, I'd spend hours wading through blogs full of beautiful
      photos, breathless prose, and almost no useful information. How do you
      actually get from A to B? What does it cost? How long does it take? What
      do you wish you'd known before you went? This site is our answer to that.
      I've travelled to some brilliant, complicated, occasionally exhausting
      places and I've written it all up the way I'd have wanted to find it. Day
      by day, decision by decision, with the practical detail left in.
    </p>

    <p>
      No fluff. No package tours. Just the full story of trips we actually did.
    </p>

    <a href="/about" class="about-link">Read the full story →</a>
  </section>

  <section class="trips">
    <span class="section-label">Trips</span>
    <div class="grid">
      {recentTrips.slice(0, 3).map((trip) => <TripCard {...trip} />)}
    </div>
    <a href="/trips" class="trips-link">See all trips →</a>
  </section>

  <footer>
    <span class="footer-wordmark">Well Trodden</span>
    <span class="footer-strapline">Self-directed trips, honestly told.</span>
  </footer>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 500px;
    background-image: url("/images/jungle-pool.webp");
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    color: #fff;
    padding: 0 1.5rem;
  }

  .hero-content h1 {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .hero-content p {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    opacity: 0.88;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* About section */
  .about {
    background: var(--paper);
    padding: 6rem 2.5rem 0;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .about p {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--stone);
    margin-bottom: 1.5rem;
  }

  .about-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.2rem;
    transition: opacity 0.2s;
  }

  .about-link:hover {
    opacity: 0.65;
  }

  /* Trips section */
  .trips {
    background: var(--paper);
    padding: 6rem 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dust);
    margin-bottom: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .trips-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.2rem;
    margin-top: 2.5rem;
    transition: opacity 0.2s;
  }

  .trips-link:hover {
    opacity: 0.65;
  }

  /* Footer */
  footer {
    background: var(--paper);
    border-top: 1px solid var(--border);
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-wordmark {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
  }

  .footer-strapline {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--stone);
    letter-spacing: 0.03em;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .about {
      padding: 4rem 1.25rem 0;
    }

    .trips {
      padding: 4rem 1.25rem;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    footer {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      padding: 1.5rem 1.25rem;
    }
  }
</style>
