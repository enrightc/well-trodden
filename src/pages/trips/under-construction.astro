---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
---

<Base title="Coming Soon — Well Trodden">
  <Nav />
  <section>
    <p class="label">Coming soon</p>
    <h1>This trip is still being written up.</h1>
    <p class="body">
      I'm working on it — check back soon for the full story, photos, and everything you need to know.
    </p>
    <a href="/trips" class="back-link">← Back to all trips</a>
  </section>
</Base>

<style>
  section {
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 640px;
    margin: 0 auto;
    padding: 8rem 2.5rem;
  }

  .label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dust);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }

  .body {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--stone);
    margin-bottom: 2.5rem;
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .back-link:hover {
    color: var(--stone);
  }
</style>
