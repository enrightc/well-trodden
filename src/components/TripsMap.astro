---
---

<div class="map-hero">
  <div id="hero-map" class="map-canvas" aria-hidden="true"></div>

  <div id="map-popup" class="map-popup" hidden>
    <button id="popup-closer" aria-label="Close">✕</button>
    <a class="map-popup-card" href="">
      <div class="map-popup-photo">
        <img class="map-popup-img" src="" alt="" />
      </div>
      <div class="map-popup-body">
        <span class="map-popup-region"></span>
        <p class="map-popup-title"></p>
        <div class="map-popup-pills">
          <span class="map-popup-duration"></span>
          <span class="map-popup-type"></span>
        </div>
      </div>
    </a>
  </div>
</div>

<script>
  import Map from "ol/Map";
  import View from "ol/View";
  import VectorLayer from "ol/layer/Vector";
  import VectorSource from "ol/source/Vector";
  import GeoJSON from "ol/format/GeoJSON";
  import { Fill, Stroke, Style } from "ol/style";
  import Overlay from "ol/Overlay";
  import { defaults as defaultInteractions, MouseWheelZoom } from "ol/interaction";
  import { platformModifierKeyOnly } from "ol/events/condition";

  type TripData = {
    title: string;
    region: string;
    duration: string;
    tripType: string;
    image: string;
    href: string;
  };

  const TRIPS: Record<string, TripData> = {
    Guatemala: {
      title: "Guatemala & Belize",
      region: "Central America",
      duration: "16 days",
      tripType: "Shuttle & hire car",
      image: "/images/trips/guatemala-belize/hero.webp",
      href: "/trips/guatemala-belize",
    },
    Belize: {
      title: "Guatemala & Belize",
      region: "Central America",
      duration: "16 days",
      tripType: "Shuttle & hire car",
      image: "/images/trips/guatemala-belize/hero.webp",
      href: "/trips/guatemala-belize",
    },
    Iceland: {
      title: "Iceland",
      region: "Europe",
      duration: "10 days",
      tripType: "Campervan",
      image: "/images/trips/iceland/iceland-hero.webp",
      href: "/trips/under-construction",
    },
    Jordan: {
      title: "Jordan",
      region: "Middle East",
      duration: "10 days",
      tripType: "Hire car",
      image: "/images/trips/jordan/jordan-hero.webp",
      href: "/trips/under-construction",
    },
    Malaysia: {
      title: "Malaysia",
      region: "Asia",
      duration: "",
      tripType: "",
      image: "/images/trips/malaysia/malaysia-hero.webp",
      href: "/trips/under-construction",
    },
    Japan: {
      title: "Japan",
      region: "Asia",
      duration: "",
      tripType: "",
      image: "/images/trips/japan/japan-hero.webp",
      href: "/trips/under-construction",
    },
    Peru: {
      title: "Bolivia and Peru",
      region: "South America",
      duration: "",
      tripType: "",
      image: "/images/trips/bolivia-peru/bolivia-peru-hero.webp",
      href: "/trips/under-construction",
    },
    Bolivia: {
      title: "Bolivia and Peru",
      region: "South America",
      duration: "",
      tripType: "",
      image: "/images/trips/bolivia-peru/bolivia-peru-hero.webp",
      href: "/trips/under-construction",
    },
    Italy: {
      title: "Italy",
      region: "Europe",
      duration: "3 trips",
      tripType: "",
      image: "/images/trips/rome/rome-hero.webp",
      href: "/trips/italy",
    },
    Poland: {
      title: "Krakow, Poland",
      region: "Europe",
      duration: "",
      tripType: "",
      image: "/images/trips/krakow/krakow-hero.webp",
      href: "/trips/under-construction",
    },
    Portugal: {
      title: "Porto, Portugal",
      region: "Europe",
      duration: "",
      tripType: "",
      image: "/images/trips/porto/porto-hero.webp",
      href: "/trips/under-construction",
    },
    "Czech Republic": {
      region: "Europe",
      title: "Prague, Czech Republic",
      duration: "",
      tripType: "",
      image: "/images/trips/prague/prague-hero.webp",
      href: "/trips/under-construction",
    },
    "Taiwan": {
      region: "Asia",
      title: "Taiwan, Asia",
      duration: "",
      tripType: "",
      image: "/images/trips/taiwan/taiwan-hero.webp",
      href: "/trips/under-construction",
    },
  };

  const VISITED = new Set(Object.keys(TRIPS));

  const BORDER = new Stroke({ color: "rgba(26, 25, 22, 0.25)", width: 0.5 });

  const unvisitedStyle = new Style({
    fill: new Fill({ color: "#E8E4DE" }),
    stroke: BORDER,
  });

  const visitedStyle = new Style({
    fill: new Fill({ color: "#6B6860" }),
    stroke: BORDER,
  });

  const hoverStyle = new Style({
    fill: new Fill({ color: "#3d3c38" }),
    stroke: BORDER,
  });

  function styleCountry(feature: FeatureLike) {
    return VISITED.has(feature.get("name")) ? visitedStyle : unvisitedStyle;
  }

  const source = new VectorSource({
    format: new GeoJSON(),
    url: "/data/world.geojson",
  });

  const vectorLayer = new VectorLayer({ source, style: styleCountry });

  const container = document.getElementById('map-popup')!;
  const closer = document.getElementById('popup-closer')!;
  const popupCard = container.querySelector('.map-popup-card') as HTMLAnchorElement;
  const popupImg = container.querySelector('.map-popup-img') as HTMLImageElement;
  const popupRegion = container.querySelector('.map-popup-region')!;
  const popupTitle = container.querySelector('.map-popup-title')!;
  const popupDuration = container.querySelector('.map-popup-duration')!;
  const popupType = container.querySelector('.map-popup-type')!;
  const popupPills = container.querySelector('.map-popup-pills') as HTMLElement;

  const overlay = new Overlay({
    element: container,
    autoPan: {
      animation: {
        duration: 250,
      },
    },
  });

  // Below this width the map is a static illustration: panning/zooming a world
  // map with a fingertip is too fiddly to be worth it, and the full trip list
  // right below already covers browsing by region.
  const isStatic = window.matchMedia("(max-width: 768px)").matches;

  const map = new Map({
    target: "hero-map",
    layers: [vectorLayer],
    controls: [],
    overlays: [overlay],
    // Require Ctrl/Cmd+scroll to zoom the map so plain scrolling passes through
    // to the page instead of getting captured by the map when the cursor is over it.
    interactions: isStatic
      ? []
      : defaultInteractions({ mouseWheelZoom: false }).extend([
          new MouseWheelZoom({ condition: platformModifierKeyOnly }),
        ]),
    view: new View({
      projection: "EPSG:4326",
      center: [10, 20],
      zoom: 1,
      showFullExtent: true,
    }),
  });

  function showPopup(trip: TripData, coordinate: number[]) {
    popupCard.href = trip.href;
    popupImg.src = trip.image;
    popupImg.alt = trip.title;
    popupRegion.textContent = trip.region;
    popupTitle.textContent = trip.title;
    popupDuration.textContent = trip.duration;
    popupType.textContent = trip.tripType;
    popupPills.hidden = !trip.duration && !trip.tripType;
    container.hidden = false;
    overlay.setPosition(coordinate);
  }

  function hidePopup() {
    overlay.setPosition(undefined);
    container.hidden = true;
  }

  closer.onclick = function () {
    hidePopup();
    closer.blur();
    return false;
  };

  if (!isStatic) {
    // Touch devices don't fire pointermove on hover, so fall back to tap-to-open.
    map.on('singleclick', function (evt) {
      const feature = map.forEachFeatureAtPixel(evt.pixel, (f) => f);
      const name = feature?.get('name');
      const trip = name && TRIPS[name];

      if (trip) {
        showPopup(trip, evt.coordinate);
      } else {
        hidePopup();
      }
    });

    let hoveredFeature: ReturnType<typeof map.forEachFeatureAtPixel> = null;

    map.on("pointermove", (evt) => {
      if (hoveredFeature) {
        (hoveredFeature as any).setStyle(undefined);
        hoveredFeature = null;
      }
      let name: string | undefined;
      map.forEachFeatureAtPixel(evt.pixel, (feature) => {
        name = feature.get("name");
        if (name && VISITED.has(name)) {
          (feature as any).setStyle(hoverStyle);
          hoveredFeature = feature;
        }
        return true;
      });
      map.getTargetElement().style.cursor = hoveredFeature ? "pointer" : "";

      // Only switch/open on hovering a visited country; leaving it alone otherwise
      // keeps the popup open (and clickable) once shown, until closed explicitly.
      const trip = name && TRIPS[name];
      if (trip) {
        showPopup(trip, evt.coordinate);
      }
    });
  }

  source.once("featuresloadend", () => {
    map.getView().fit([-168, -58, 178, 80], { padding: [32, 32, 32, 32] });
  });
</script>

<style>
  .map-hero {
    margin-top: 5rem;
    position: relative;
    height: 80svh;
    min-height: 500px;
    overflow: hidden;
    background: var(--paper);
  }

  .map-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--paper);
  }

  @media (max-width: 768px) {
    /* Map is non-interactive below this width (see isStatic in the script);
       drop pointer events too so touches fall through to normal page scroll. */
    .map-canvas {
      pointer-events: none;
    }
  }

  /* popup */

  .map-popup {
    width: 220px;
    position: relative;
  }

  #popup-closer {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    border-radius: 100px;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.65rem;
    color: var(--ink);
    line-height: 1;
  }

  .map-popup-card {
    display: block;
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(26, 25, 22, 0.08), 0 4px 16px rgba(26, 25, 22, 0.12);
    text-decoration: none;
  }

  .map-popup-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .map-popup-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .map-popup-body {
    padding: 0.85rem 1rem 1rem;
  }

  .map-popup-region {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dust);
    margin-bottom: 0.3rem;
  }

  .map-popup-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
    margin: 0 0 0.6rem;
  }

  .map-popup-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .map-popup-duration,
  .map-popup-type {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--stone);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.2rem 0.6rem;
  }
</style>
