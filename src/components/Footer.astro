---
---

<footer class="site-footer">
  <span class="footer-wordmark">Well Trodden</span>
  <div class="footer-meta">
    <span class="footer-strapline">Self-directed trips, honestly told.</span>
    <button type="button" class="footer-link" data-cc="show-preferencesModal">
      Cookie preferences
    </button>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper);
    border-top: 1px solid var(--border);
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-wordmark {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-strapline {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--stone);
    letter-spacing: 0.03em;
  }

  .footer-link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: var(--stone);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .site-footer {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
      padding: 1.5rem 1.25rem;
    }

    .footer-meta {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
